{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main and splash windows.",
  "windows": ["main", "splash"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default"
  ]
}
