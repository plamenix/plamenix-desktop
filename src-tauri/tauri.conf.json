{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plamenix",
  "version": "1.0.0-beta.0",
  "identifier": "dev.plamenix.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "width": 500,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "skipTaskbar": false,
        "visible": true,
        "title": "Plamenix"
      },
      {
        "label": "main",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "title": "Plamenix",
        "backgroundColor": "#13161f",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: https://asset.localhost; object-src 'self' blob:; frame-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/plugins": "plugins",
      "../resources/fbclient": "fbclient"
    },
    "category": "DeveloperTool",
    "shortDescription": "Plamenix \u2014 Firebird IDE",
    "longDescription": "Plamenix is an open-source IDE for Firebird databases.",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  }
}
